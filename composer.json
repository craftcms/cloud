{
  "minimum-stability": "dev",
  "name": "craftcms/cloud",
  "description": "Run Craft CMS on Craft Cloud.",
  "license": "proprietary",
  "type": "library",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/timkelty/laravel-bridge"
    }
  ],
  "require": {
    "ext-curl": "*",
    "bref/bref": "^3",
    "bref/extra-php-extensions": "^3",
    "bref/laravel-bridge": "dev-bugfix/emergency-logger as 3.0.4",
    "craftcms/cms": "^6",
    "symfony/process": "^7.4.5 || ^8.0.5"
  },
  "require-dev": {
    "carthage-software/mago": "^1.1.0",
    "pestphp/pest": "^4.0"
  },
  "scripts": {
    "lint": "mago lint --minimum-fail-level=warning && mago format --check",
    "fix": "mago lint --fix --format-after-fix && mago format",
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "./vendor/bin/pest --compact"
    ]
  },
  "autoload": {
    "psr-4": {
      "craft\\cloud\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "craft\\cloud\\tests\\": "tests/"
    },
    "files": [
      "tests/Support/functions.php"
    ]
  },
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true,
      "craftcms/plugin-installer": false,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "craft\\cloud\\CloudServiceProvider"
      ]
    }
  }
}
