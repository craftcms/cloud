{
  "minimum-stability": "dev",
  "name": "craftcms/cloud",
  "description": "Run Craft CMS on Craft Cloud.",
  "license": "proprietary",
  "type": "library",
  "require": {
    "bref/bref": "^3",
    "bref/extra-php-extensions": "^3",
    "bref/laravel-bridge": "^3.1",
    "craftcms/cms": "^6.0.0-beta.1",
    "symfony/process": "^7.4.5 || ^8.0.5",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "carthage-software/mago": "^1.1.0",
    "pestphp/pest": "^4.0",
    "orchestra/testbench": "^11.0"
  },
  "scripts": {
    "lint": "mago lint --minimum-fail-level=warning && mago format --check",
    "fix": "mago lint --fix --format-after-fix && mago format",
    "test": [
      "Composer\\Config::disableProcessTimeout",
      "./vendor/bin/pest --compact"
    ]
  },
  "autoload": {
    "psr-4": {
      "CraftCms\\Cloud\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\Cloud\\Tests\\": "tests/"
    },
    "files": [
      "tests/Support/functions.php"
    ]
  },
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "carthage-software/mago": true,
      "craftcms/plugin-installer": false,
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "CraftCms\\Cloud\\CloudServiceProvider"
      ]
    }
  }
}
